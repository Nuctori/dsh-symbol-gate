{
  "name": "dsh-symbol-gate",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Turn-end code gate for DeepSeek Harness: one read-only LLM audit of this turn's diff against a type-theory checklist (binding, resource linearity, effects, assertion honesty, exhaustiveness).",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0",
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gate",
    "code-audit",
    "type-theory"
  ],
  "license": "MIT"
}
